# =========================================================
# .gitignore for LaTeX Beamer course material (26ESCC106)
# Place this file in the repository root (the "Modules" folder)
# =========================================================

# ---------- LaTeX build files ----------
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.xdv
*.vrb
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.lof
*.lot
*.dvi
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg
*.ist
*.thm
*.listing
_minted*/
*.pyg

# ---------- LaTeX source files (kept private) ----------
# Only the compiled PDFs are published. The .tex sources stay on the
# author's computer, in every folder (Presentation, Handouts, Notes,
# Git and GitHub, and any future module).
*.tex
*.sty
*.cls
*.bib

# ---------- Compiled PDFs ----------
# main.pdf, handout.pdf, notes.pdf and git-github-handout.pdf are
# published so that students can download them.

# Preview PDFs shared during drafting (duplicates of the compiled PDFs)
*_preview.pdf

# Zip packages of the sources
*.zip

# ---------- Copyrighted textbook excerpts ----------
# Do not publish scanned/extracted textbook pages in a public repository.
Textbook Excerpt/
**/Textbook Excerpt/

# ---------- Editor and OS files ----------
.vscode/
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini